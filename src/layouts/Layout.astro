---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Malika Shakila is a frontend engineer, UI/UX designer, mentor, and founder building thoughtful digital products, creative web experiences, and technology driven businesses from idea to launch.",
  canonical,
  ogImage = "https://malika.engineer/preview.png",
  ogType = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://malika.engineer");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Malika Shakila" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="keywords"
      content="Malika Shakila, Malsky, software engineer, UI/UX mentor, Astro, React, Next.js, web performance, portfolio"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/me.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/me.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/me.webp" />
    <link rel="icon" type="image/png" sizes="16x16" href="/me.webp" />

    <!-- Canonical (PER PAGE) -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Non-blocking font load -->
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.cdnfonts.com/css/montserrat" />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/montserrat" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/montserrat" />
    </noscript>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Malika Shakila" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@msyncq" />

    <!-- JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Malika Shakila",
      "alternateName": ["Malsky"],
      "url": "https://malika.engineer",
      "image": "https://malika.engineer/me.webp",
      "jobTitle": "Frontend Engineer",
      "description": "Frontend Engineer & UI/UX Mentor building modern web applications with Astro, React, and Next.js.",
      "sameAs": [
        "https://github.com/icecoffie",
        "https://linkedin.com/in/malikashkl",
        "https://twitter.com/msyncq"
      ],
      "knowsAbout": ["Software Engineering", "Frontend Engineer" , "UI/UX", "Astro", "React", "Next.js", "Web Performance"]
    }
    </script>

    <title>{title}</title>
  </head>

  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --sec: #007bff;
    --sec-dark: #0069d9;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family: "Montserrat", -apple-system, system-ui, sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }
    .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 0;
    height: 0;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: transparent;
  }

  * {
    scrollbar-width: none;
    scrollbar-color: transparent transparent;
  }
</style>
