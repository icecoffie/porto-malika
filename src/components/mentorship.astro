---
// Mentorship section - focused on stats and CTA
---

<section
  id="mentorship"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-6xl mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-12">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mentorship</h2>
      <h3 class="text-4xl md:text-5xl font-medium mb-4">Empowering the Next Generation</h3>
      <p class="text-lg text-[var(--white-icon)] max-w-3xl">
        As a UI/UX mentor at ISC and founder of Skale Academy, I'm passionate about helping aspiring designers and developers build successful careers in tech.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 p-8 rounded-2xl bg-gradient-to-r from-[var(--sec)]/10 to-transparent border border-[var(--sec)]/30">
      <div class="text-center">
        <div class="text-4xl font-bold text-[var(--sec)] mb-2">50+</div>
        <div class="text-sm text-[var(--white-icon)]">Students Mentored</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-bold text-[var(--sec)] mb-2">85%</div>
        <div class="text-sm text-[var(--white-icon)]">Career Advancement</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-bold text-[var(--sec)] mb-2">3x</div>
        <div class="text-sm text-[var(--white-icon)]">Avg. Rate Increase</div>
      </div>
      <div class="text-center">
        <div class="text-4xl font-bold text-[var(--sec)] mb-2">100+</div>
        <div class="text-sm text-[var(--white-icon)]">Sessions Delivered</div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <p class="text-lg text-[var(--white-icon)] mb-6">
        Want to level up your design or development career?
      </p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-[var(--sec)] to-blue-400 text-white font-medium hover:shadow-lg hover:shadow-[var(--sec)]/50 transition-all duration-300 hover:scale-105"
      >
        <span>Get Mentorship</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"/>
        </svg>
      </a>
    </div>
  </div>
</section>
