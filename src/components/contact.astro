---
import ContactFolders from "../React/ContactFolders.tsx";
---

<!-- overflow-visible lets folder papers fly upward without being clipped -->
<section
  id="contact"
  class="w-full py-12 sm:py-16 border-t border-[#ffffff10] text-[var(--white)] overflow-visible"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <h2 class="text-base sm:text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-2xl sm:text-3xl md:text-4xl font-medium text-[var(--white)] mb-8 sm:mb-10">Contact</h3>

    <!-- Two-column on desktop, stacked on mobile -->
    <div class="flex flex-col md:flex-row gap-6 md:gap-16 items-center">

      <!-- LEFT: folder — scaled down & centered on mobile so it doesn't overlap -->
      <div class="w-full md:w-60 md:flex-shrink-0 flex justify-center scale-75 sm:scale-90 md:scale-100 origin-top">
        <ContactFolders client:visible />
      </div>

      <!-- RIGHT: form -->
      <div class="w-full md:flex-1 min-w-0">
        <form
          id="contact-form"
          action="https://formspree.io/f/xjkrorey"
          method="POST"
          class="flex flex-col gap-5 sm:gap-6 bg-[#141414d9] p-5 sm:p-6 rounded-xl shadow-lg border border-[#ffffff08]"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
            <input
              type="text"
              name="first_name"
              placeholder="First Name"
              required
              class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-shadow w-full"
            />
            <input
              type="text"
              name="last_name"
              placeholder="Last Name"
              required
              class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-shadow w-full"
            />
          </div>
          <input
            type="email"
            name="reply_to"
            placeholder="Email"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-shadow w-full"
          />
          <textarea
            name="message"
            placeholder="Message"
            rows={5}
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none transition-shadow w-full"
          ></textarea>
          <button
            type="submit"
            class="px-6 py-3 bg-gradient-to-r from-[var(--sec)] to-blue-400 text-white rounded-lg font-medium hover:shadow-lg hover:shadow-[var(--sec)]/50 hover:scale-105 transition-all duration-300"
          >
            Send Message
          </button>
        </form>
        <div
          id="form-status"
          class="hidden mt-4 px-4 py-2 rounded-lg text-[var(--white)] bg-green-600/80 text-center text-sm"
        >
          Thanks! Message sent successfully.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const formStatus = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.reset();
        formStatus?.classList.remove("hidden");
      } else {
        if (formStatus) formStatus.textContent = "Problem sending. Try again.";
        formStatus?.classList.remove("hidden");
      }
    } catch {
      if (formStatus) formStatus.textContent = "Problem sending. Try again.";
      formStatus?.classList.remove("hidden");
    }
  });
</script>