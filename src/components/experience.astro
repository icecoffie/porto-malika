const typeLabel: Record<ExperienceItem["type"], string> = {
  intern: "Intern",
  parttime: "Part time",
  contract: "Contract",
  fulltime: "Full time",
  freelance: "Freelance",
};
---

<section id="experience" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Career Journey</h2>
    <div class="flex items-end justify-between gap-6 mb-10">
      <h3 class="text-4xl md:text-5xl font-medium">Experience</h3>
    </div>

    <div class="stack-pro">
      {experienceData.map((exp, i) => (
        <section class="step" style={`--i:${i}; --n:${experienceData.length};`}>
          <article class="card group" aria-label={`${exp.role} at ${exp.company}`}>
            <div class="bgfx"></div>

            <header class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-4 min-w-0">
                <div class="logo">
                  <img
                    src={exp.logoSrc}
                    alt={`${exp.company} logo`}
                    class="logoImg"
                    loading="lazy"
                    decoding="async"
                    width="32"
                    height="32"
                  />
                </div>

                <div class="min-w-0">
                  <p class="text-xs text-[var(--white-icon)] truncate">
                    {exp.company}{exp.location ? <span class="opacity-70"> • {exp.location}</span> : null}
                  </p>

                  <h4 class="mt-1 text-2xl md:text-3xl font-bold leading-tight">
                    {exp.role}
                  </h4>

                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <span class="pill">{exp.year}</span>
                    <span class="pillSec">{typeLabel[exp.type]}</span>
                  </div>
                </div>
              </div>

              <div class="hidden md:flex items-center gap-2">
                <span class="chip">#{String(i + 1).padStart(2, "0")}</span>
              </div>
            </header>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6">
              <ul class="md:col-span-7 text-[var(--white-icon)] text-sm leading-relaxed space-y-2">
                {exp.highlights.slice(0, 3).map((h) => (
                  <li class="flex gap-2">
                    <span class="mt-2 size-1.5 rounded-full bg-[var(--sec)]/80 shrink-0"></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <div class="md:col-span-5">
                <div class="tags">
                  {exp.tags.slice(0, 8).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>

                <div class="hint">
                  <span class="dot"></span>
                  <span>keep scrolling</span>
                </div>
              </div>
            </div>
          </article>
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    const steps = [...document.querySelectorAll(".step")];
    const cards = steps.map(s => s.querySelector(".card"));
    const clamp = (n, a, b) => Math.min(b, Math.max(a, n));
    const lerp = (a, b, t) => a + (b - a) * t;

    let ticking = false;

    const update = () => {
      ticking = false;
      const vh = window.innerHeight;

      steps.forEach((step, idx) => {
        const rect = step.getBoundingClientRect();

        // progress: 0..1 when step enters viewport
        const p = clamp((vh - rect.top) / (vh * 0.85), 0, 1);

        // Softer stack values:
        const depth = idx;
        const baseScale = 1 - depth * 0.018; // less harsh
        const scale = lerp(baseScale - 0.02, baseScale, p);

        // more “organic” stacking: overlap + gentle lift
        const y = lerp(24 + depth * 10, depth * 8, p);

        // tiny rotation gives life, not stiff
        const rot = lerp((idx % 2 === 0 ? -1.2 : 1.2) - depth * 0.12, (idx % 2 === 0 ? -0.2 : 0.2), p);

        // opacity + blur for depth
        const opacity = lerp(0.86, 1, p);
        const blur = lerp(2.8, 0, p);

        const card = cards[idx];
        if (!card) return;

        card.style.transform = `translateY(${y}px) scale(${scale}) rotate(${rot}deg)`;
        card.style.opacity = opacity.toFixed(3);
        card.style.filter = `blur(${blur}px)`;
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  </script>

  <style is:inline>
    /* wrapper */
    .stack-pro{
      display: grid;
      gap: 26px;
    }

    /* each step gives room for the next card to stack */
    .step{
      position: relative;
      height: 520px;
    }
    @media (min-width: 768px){
      .step{ height: 560px; }
    }

    /* Card sticky */
    .card{
      position: sticky;
      top: 104px;
      border-radius: 34px;
      border: 1px solid #ffffff10;
      background: #0f0f0f;
      padding: 28px;
      overflow: hidden;
      transform-origin: center top;
      will-change: transform, opacity, filter;
      transition: border-color .35s ease, box-shadow .35s ease;
    }
    @media (min-width: 768px){
      .card{ padding: 32px; top: 112px; }
    }

    /* Hover: deepen and a bit “lift” */
    .card:hover{
      border-color: color-mix(in oklab, var(--sec) 65%, transparent);
      box-shadow:
        0 0 44px -18px color-mix(in oklab, var(--sec) 55%, transparent),
        0 14px 50px -30px rgba(0,0,0,.75);
    }

    /* background fx */
    .bgfx{
      position:absolute;
      inset:-2px;
      pointer-events:none;
      background:
        radial-gradient(620px circle at 18% 15%, rgba(255,255,255,.08), transparent 55%),
        radial-gradient(520px circle at 82% 70%, color-mix(in oklab, var(--sec) 40%, transparent), transparent 60%),
        linear-gradient(120deg, transparent 0%, rgba(255,255,255,.06) 35%, transparent 70%);
      opacity: .32;
      transform: translateX(-55%);
      animation: sweep 8s ease-in-out infinite;
      mix-blend-mode: screen;
    }
    @keyframes sweep{
      0%{ transform: translateX(-60%); opacity:.20; }
      45%{ opacity:.34; }
      100%{ transform: translateX(60%); opacity:.20; }
    }

    /* Logo bubble */
    .logo{
      width: 54px;
      height: 54px;
      border-radius: 9999px;
      border: 1px solid #ffffff14;
      background: rgba(0,0,0,.35);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      flex: 0 0 auto;
      box-shadow: 0 0 26px -18px var(--sec);
    }
    .logoImg{
      width: 32px;
      height: 32px;
      object-fit: contain;
      opacity: .96;
    }

    /* Pills */
    .pill{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 9999px;
      font-size: 10px;
      border: 1px solid #ffffff20;
      color: var(--white-icon);
      background: rgba(255,255,255,.02);
    }
    .pillSec{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 9999px;
      font-size: 10px;
      border: 1px solid color-mix(in oklab, var(--sec) 35%, transparent);
      color: var(--sec);
      background: color-mix(in oklab, var(--sec) 12%, transparent);
      text-transform: uppercase;
      letter-spacing: .12em;
    }
    .chip{
      font-size: 10px;
      letter-spacing: .18em;
      text-transform: uppercase;
      padding: 8px 12px;
      border-radius: 9999px;
      border: 1px solid #ffffff14;
      background: rgba(255,255,255,.03);
      color: rgba(255,255,255,.75);
    }

    /* Tags */
    .tags{
      display:flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .tag{
      padding: 6px 10px;
      border-radius: 10px;
      font-size: 12px;
      background: #111;
      color: rgba(255,255,255,.85);
      border: 1px solid #ffffff10;
      transition: border-color .3s ease, transform .3s ease;
    }
    .card:hover .tag{
      border-color: color-mix(in oklab, var(--sec) 28%, transparent);
      transform: translateY(-1px);
    }
    
    .hint{
      margin-top: 16px;
      display:flex;
      align-items:center;
      gap: 10px;
      font-size: 11px;
      color: rgba(255,255,255,.55);
    }
    .dot{
      width: 6px;
      height: 6px;
      border-radius: 9999px;
      background: color-mix(in oklab, var(--sec) 80%, transparent);
      box-shadow: 0 0 18px -4px var(--sec);
    }

    /* reduce motion */
    @media (prefers-reduced-motion: reduce){
      .bgfx{ animation: none; }
      .card{ filter:none !important; transform:none !important; }
    }
  </style>
</section>
