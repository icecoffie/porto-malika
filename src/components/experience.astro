---

<section id="experience" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Career Journey</h2>
    <div class="flex items-end justify-between gap-6 mb-10">
      <h3 class="text-4xl md:text-5xl font-medium">Experience</h3>
    </div>

    <div class="exp-stack">
      {experienceData.map((exp, i) => (
        <section class="exp-step" style={`--i:${i}; --n:${experienceData.length};`}>
          <article class="exp-card group" aria-label={`${exp.role} at ${exp.company}`}>
            <div class="exp-bgfx"></div>

            <header class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-4 min-w-0">
                <div class="exp-logo">
                  <img
                    src={exp.logoSrc}
                    alt={`${exp.company} logo`}
                    class="exp-logoImg"
                    loading="lazy"
                    decoding="async"
                    width="32"
                    height="32"
                  />
                </div>

                <div class="min-w-0">
                  <p class="text-xs text-[var(--white-icon)] truncate">
                    {exp.company}{exp.location ? <span class="opacity-70"> • {exp.location}</span> : null}
                  </p>

                  <h4 class="mt-1 text-2xl md:text-3xl font-bold leading-tight">
                    {exp.role}
                  </h4>

                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <span class="exp-pill">{exp.year}</span>
                    <span class="exp-pillSec">{typeLabel[exp.type]}</span>
                  </div>
                </div>
              </div>

              <div class="hidden md:flex items-center gap-2">
                <span class="exp-chip">#{String(i + 1).padStart(2, "0")}</span>
              </div>
            </header>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6">
              <ul class="md:col-span-7 text-[var(--white-icon)] text-sm leading-relaxed space-y-2">
                {exp.highlights.slice(0, 3).map((h) => (
                  <li class="flex gap-2">
                    <span class="mt-2 size-1.5 rounded-full bg-[var(--sec)]/80 shrink-0"></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <div class="md:col-span-5">
                <div class="exp-tags">
                  {exp.tags.slice(0, 8).map((tag) => (
                    <span class="exp-tag">{tag}</span>
                  ))}
                </div>

                <div class="exp-hint hidden md:flex">
                  <span class="exp-dot"></span>
                  <span>keep scrolling</span>
                </div>
              </div>
            </div>
          </article>
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.getElementById("experience");
      if (!root) return;

      const mq = window.matchMedia("(min-width: 768px)");
      const steps = [...root.querySelectorAll(".exp-step")];
      const cards = steps.map(s => s.querySelector(".exp-card")).filter(Boolean);

      const clamp = (n, a, b) => Math.min(b, Math.max(a, n));
      const lerp = (a, b, t) => a + (b - a) * t;

      let rafId = 0;

      const reset = () => {
        steps.forEach((s) => (s.style.height = ""));
        cards.forEach((c) => {
          c.style.transform = "";
          c.style.opacity = "";
          c.style.filter = "";
        });
      };

      const measureAndSetHeights = () => {
        // dynamic heights so it never breaks other sections / screens
        const base = Math.max(...cards.map(c => c.getBoundingClientRect().height)) || 520;
        // room per step so stacking feels right
        const stepH = Math.round(base + 220);
        steps.forEach((s) => (s.style.height = `${stepH}px`));
      };

      const update = () => {
        rafId = 0;
        if (!mq.matches) return;

        const vh = window.innerHeight;

        steps.forEach((step, idx) => {
          const rect = step.getBoundingClientRect();
          const p = clamp((vh - rect.top) / (vh * 0.9), 0, 1);

          const depth = idx;
          const baseScale = 1 - depth * 0.016;
          const scale = lerp(baseScale - 0.012, baseScale, p);

          const y = lerp(18 + depth * 10, depth * 7, p);
          const rot = lerp((idx % 2 === 0 ? -1.0 : 1.0) - depth * 0.08, (idx % 2 === 0 ? -0.2 : 0.2), p);

          const opacity = lerp(0.92, 1, p);
          const blur = lerp(1.8, 0, p);

          const card = cards[idx];
          if (!card) return;

          card.style.transform = `translateY(${y}px) scale(${scale}) rotate(${rot}deg)`;
          card.style.opacity = opacity.toFixed(3);
          card.style.filter = `blur(${blur}px)`;
        });
      };

      const schedule = () => {
        if (rafId) return;
        rafId = requestAnimationFrame(update);
      };

      const setup = () => {
        reset();
        if (!mq.matches) return;
        measureAndSetHeights();
        schedule();
      };

      // init
      setup();
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", () => {
        setup();
      });

      mq.addEventListener?.("change", () => {
        setup();
      });
    })();
  </script>

  <style is:inline>
    /* ====== scoped: ONLY affects #experience ====== */
    #experience .exp-stack{
      display: grid;
      gap: 26px;
    }

    /* MOBILE DEFAULT: normal layout, no forced heights, no sticky */
    #experience .exp-step{
      position: relative;
      height: auto;
    }

    #experience .exp-card{
      position: relative;
      top: auto;
      border-radius: 24px; /* closer to Education */
      border: 1px solid #ffffff10;
      background: #111;    /* match your other cards */
      padding: 24px;
      overflow: hidden;
      transform-origin: center top;
      transition: border-color .35s ease, box-shadow .35s ease, transform .35s ease;
    }

    /* DESKTOP: enable stacked sticky */
    @media (min-width: 768px){
      #experience .exp-card{
        position: sticky;
        top: 112px;
        border-radius: 34px;
        background: #0f0f0f;
        padding: 32px;
        will-change: transform, opacity, filter;
      }
    }

    #experience .exp-card:hover{
      border-color: color-mix(in oklab, var(--sec) 65%, transparent);
      box-shadow:
        0 0 44px -18px color-mix(in oklab, var(--sec) 55%, transparent),
        0 14px 50px -30px rgba(0,0,0,.75);
    }

    #experience .exp-bgfx{
      position:absolute;
      inset:-2px;
      pointer-events:none;
      background:
        radial-gradient(620px circle at 18% 15%, rgba(255,255,255,.08), transparent 55%),
        radial-gradient(520px circle at 82% 70%, color-mix(in oklab, var(--sec) 40%, transparent), transparent 60%),
        linear-gradient(120deg, transparent 0%, rgba(255,255,255,.06) 35%, transparent 70%);
      opacity: .32;
      transform: translateX(-55%);
      animation: expSweep 8s ease-in-out infinite;
      mix-blend-mode: screen;
    }
    @keyframes expSweep{
      0%{ transform: translateX(-60%); opacity:.20; }
      45%{ opacity:.34; }
      100%{ transform: translateX(60%); opacity:.20; }
    }

    #experience .exp-logo{
      width: 54px;
      height: 54px;
      border-radius: 9999px;
      border: 1px solid #ffffff14;
      background: rgba(0,0,0,.35);
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
      flex: 0 0 auto;
      box-shadow: 0 0 26px -18px var(--sec);
    }
    #experience .exp-logoImg{
      width: 32px;
      height: 32px;
      object-fit: contain;
      opacity: .96;
    }

    #experience .exp-pill{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 9999px;
      font-size: 10px;
      border: 1px solid #ffffff20;
      color: var(--white-icon);
      background: rgba(255,255,255,.02);
    }
    #experience .exp-pillSec{
      display:inline-flex;
      align-items:center;
      padding: 6px 10px;
      border-radius: 9999px;
      font-size: 10px;
      border: 1px solid color-mix(in oklab, var(--sec) 35%, transparent);
      color: var(--sec);
      background: color-mix(in oklab, var(--sec) 12%, transparent);
      text-transform: uppercase;
      letter-spacing: .12em;
    }
    #experience .exp-chip{
      font-size: 10px;
      letter-spacing: .18em;
      text-transform: uppercase;
      padding: 8px 12px;
      border-radius: 9999px;
      border: 1px solid #ffffff14;
      background: rgba(255,255,255,.03);
      color: rgba(255,255,255,.75);
    }

    #experience .exp-tags{
      display:flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    #experience .exp-tag{
      padding: 6px 10px;
      border-radius: 10px;
      font-size: 12px;
      background: #111;
      color: rgba(255,255,255,.85);
      border: 1px solid #ffffff10;
      transition: border-color .3s ease, transform .3s ease;
    }
    #experience .exp-card:hover .exp-tag{
      border-color: color-mix(in oklab, var(--sec) 28%, transparent);
      transform: translateY(-1px);
    }

    #experience .exp-hint{
      margin-top: 16px;
      align-items:center;
      gap: 10px;
      font-size: 11px;
      color: rgba(255,255,255,.55);
    }
    #experience .exp-dot{
      width: 6px;
      height: 6px;
      border-radius: 9999px;
      background: color-mix(in oklab, var(--sec) 80%, transparent);
      box-shadow: 0 0 18px -4px var(--sec);
    }

    @media (prefers-reduced-motion: reduce){
      #experience .exp-bgfx{ animation: none; }
      #experience .exp-card{ transform:none !important; filter:none !important; }
    }
  </style>
</section>
