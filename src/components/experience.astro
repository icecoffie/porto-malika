---

<section id="experience" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Career Journey</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-10">Experience</h3>

    <div class="exp-stack grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:block">
      {experienceData.map((exp, i) => (
        <section class="exp-step" style={`--i:${i}; --n:${experienceData.length};`}>
          <article class="exp-card group">
            <div class="exp-bgfx"></div>

            <header class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-4 min-w-0">
                <div class="exp-logo">
                  <img src={exp.logoSrc} alt={exp.company} class="exp-logoImg" width="32" height="32" loading="lazy" />
                </div>

                <div class="min-w-0">
                  <p class="text-xs text-[var(--white-icon)] truncate">
                    {exp.company}
                    {exp.location ? <span class="opacity-70"> • {exp.location}</span> : null}
                  </p>

                  <h4 class="mt-1 text-2xl md:text-3xl font-bold">{exp.role}</h4>

                  <div class="mt-3 flex flex-wrap gap-2">
                    <span class="exp-pill">{exp.year}</span>
                    <span class="exp-pillSec">{typeLabel[exp.type]}</span>
                  </div>
                </div>
              </div>

              <span class="exp-chip hidden md:inline">
                #{String(i + 1).padStart(2,"0")}
              </span>
            </header>

            <ul class="mt-6 text-sm text-[var(--white-icon)] space-y-2">
              {exp.highlights.map(h => (
                <li class="flex gap-2">
                  <span class="mt-2 size-1.5 rounded-full bg-[var(--sec)] shrink-0"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap gap-2">
              {exp.tags.map(tag => (
                <span class="exp-tag">{tag}</span>
              ))}
            </div>

            <div class="exp-hint hidden md:flex">
              <span class="exp-dot"></span>
              <span>keep scrolling</span>
            </div>
          </article>
        </section>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.getElementById("experience");
      if (!root) return;

      const mq = window.matchMedia("(min-width: 768px)");
      const steps = [...root.querySelectorAll(".exp-step")];
      const cards = steps.map(s => s.querySelector(".exp-card")).filter(Boolean);

      const clamp = (n,a,b)=>Math.min(b,Math.max(a,n));
      const lerp = (a,b,t)=>a+(b-a)*t;

      let raf = 0;

      const reset = () => {
        steps.forEach(s => s.style.height = "");
        cards.forEach(c => {
          c.style.transform = "";
          c.style.opacity = "";
          c.style.filter = "";
        });
      };

      const measure = () => {
        const base = Math.max(...cards.map(c => c.getBoundingClientRect().height)) || 520;
        steps.forEach(s => s.style.height = `${base + 220}px`);
      };

      const update = () => {
        raf = 0;
        if (!mq.matches) return;

        const vh = window.innerHeight;

        steps.forEach((step,i)=>{
          const rect = step.getBoundingClientRect();
          const p = clamp((vh - rect.top)/(vh*0.9),0,1);

          const depth = i;
          const scale = lerp(1 - depth*0.028, 1 - depth*0.016, p);
          const y = lerp(18 + depth*10, depth*7, p);
          const rot = lerp((i%2?-1:1) - depth*0.08, (i%2?-0.2:0.2), p);
          const blur = lerp(1.8,0,p);

          const card = cards[i];
          if (!card) return;

          card.style.transform = `translateY(${y}px) scale(${scale}) rotate(${rot}deg)`;
          card.style.filter = `blur(${blur}px)`;
          card.style.opacity = lerp(0.92,1,p).toFixed(3);
        });
      };

      const tick = () => {
        if (raf) return;
        raf = requestAnimationFrame(update);
      };

      const setup = () => {
        reset();
        if (!mq.matches) return;
        measure();
        tick();
      };

      setup();
      window.addEventListener("scroll", tick, { passive:true });
      window.addEventListener("resize", setup);
      mq.addEventListener?.("change", setup);
    })();
  </script>

  <style is:inline>
    #experience .exp-stack{ gap:26px; }

    #experience .exp-step{ position:relative; }

    #experience .exp-card{
      position:relative;
      border-radius:24px;
      border:1px solid #ffffff10;
      background:#111;
      padding:24px;
      overflow:hidden;
      transform-origin:center top;
    }

    @media (min-width:768px){
      #experience .exp-card{
        position:sticky;
        top:112px;
        border-radius:34px;
        background:#0f0f0f;
        padding:32px;
        will-change:transform,opacity,filter;
      }
    }

    #experience .exp-bgfx{
      position:absolute;
      inset:-2px;
      background:
        radial-gradient(620px circle at 18% 15%, rgba(255,255,255,.08), transparent 55%),
        radial-gradient(520px circle at 82% 70%, color-mix(in oklab,var(--sec) 40%,transparent), transparent 60%);
      opacity:.32;
      animation:expSweep 8s ease-in-out infinite;
      pointer-events:none;
    }

    @keyframes expSweep{
      0%{transform:translateX(-60%);}
      100%{transform:translateX(60%);}
    }

    #experience .exp-logo{
      width:54px;
      height:54px;
      border-radius:9999px;
      border:1px solid #ffffff14;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#000;
    }

    #experience .exp-logoImg{ width:32px;height:32px; }

    #experience .exp-pill,
    #experience .exp-pillSec{
      font-size:10px;
      padding:6px 10px;
      border-radius:9999px;
    }

    #experience .exp-pill{
      border:1px solid #ffffff20;
      color:var(--white-icon);
    }

    #experience .exp-pillSec{
      border:1px solid color-mix(in oklab,var(--sec) 35%,transparent);
      color:var(--sec);
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    #experience .exp-chip{
      font-size:10px;
      padding:8px 12px;
      border-radius:9999px;
      border:1px solid #ffffff14;
      color:rgba(255,255,255,.7);
    }

    #experience .exp-tag{
      font-size:12px;
      padding:6px 10px;
      border-radius:10px;
      border:1px solid #ffffff10;
      background:#111;
    }

    #experience .exp-hint{
      margin-top:16px;
      font-size:11px;
      gap:10px;
      color:rgba(255,255,255,.55);
      align-items:center;
    }

    #experience .exp-dot{
      width:6px;
      height:6px;
      border-radius:9999px;
      background:var(--sec);
    }

    @media (max-width:767px){
      #experience .exp-card{
        transform:none !important;
        filter:none !important;
        opacity:1 !important;
      }
      #experience .exp-bgfx,
      #experience .exp-hint{ display:none; }
    }
  </style>
</section>
