---
import TrueFocus from "../React/TrueFocus.tsx";
import OrbitImages from "../React/OrbitImages.tsx";

const techImages = [
  "/svg/inkspace.svg",
  "/svg/gsap.svg",
  "/svg/python.svg",
  "/svg/java.svg",
  "/svg/materialui.svg",
  "/svg/solidjs.svg",
  "/svg/supabase.svg",
  "/svg/varnish.svg",
  "/svg/react.svg",
  "/svg/typeScript.svg",
  "/svg/next.svg",
  "/svg/astro.svg",
  "/svg/Vite.js.svg",
  "/svg/tailwindcss.svg",
  "/svg/Figma.svg",
  "/svg/threejs.svg",
  "/svg/nodejs.svg",
  "/svg/Firebase.svg",
  "/svg/vue.svg",
  "/svg/javaScript.svg",
  "/svg/HTML5.svg",
  "/svg/CSS3.svg",
  "/svg/postgresql.svg",
  "/svg/CoffeeScript.svg",
  "/svg/mysql.svg",
  "/svg/Linux.svg",
];
---

<section
  id="techstack"
  class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto px-4">

    <!-- TrueFocus: two full phrases alternate -->
    <div class="mb-4 flex justify-center">
      <TrueFocus
        client:visible
        sentence="Ready To Dive In?|Let's Go Deeper"
        separator="|"
        manualMode={false}
        blurAmount={6}
        borderColor="#007bff"
        glowColor="rgba(0, 123, 255, 0.55)"
        animationDuration={0.6}
        pauseBetweenAnimations={2}
      />
    </div>

    <!-- Open To Work badge -->
    <div class="flex justify-center mb-6">
      <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-[var(--sec)]/15 border border-[var(--sec)]/40 text-[var(--sec)] font-semibold text-sm tracking-wide">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--sec)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[var(--sec)]"></span>
        </span>
        Open To Anything: Mentorship, Collaboration, or Opportunities
      </span>
    </div>

    <!-- Tech orbit — crop wrapper shows only the ellipse band -->
    <div class="relative overflow-hidden w-full" style="height: 200px;">
      <div class="w-full" style="transform: translateY(calc(-50% + 100px));">
        <OrbitImages
          client:visible
          images={techImages}
          shape="ellipse"
          radiusX={340}
          radiusY={80}
          rotation={-8}
          duration={22}
          itemSize={54}
          responsive={true}
        />
      </div>
    </div>

    <!-- LinkedIn only -->
    <div class="text-center mt-8">
      <a
        href="https://linkedin.com/in/malikashkl"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-[var(--sec)] to-blue-400 text-white font-medium hover:shadow-lg hover:shadow-[var(--sec)]/50 transition-all duration-300 hover:scale-105"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"/>
        </svg>
        Connect on LinkedIn
      </a>
    </div>

  </div>
</section>

<style>
  #techstack .focus-word {
    font-size: clamp(1.6rem, 3.5vw, 3rem);
  }
</style>
