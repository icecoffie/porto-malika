---
import { awards } from "../data/awards";
---

<section id="awards" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Recognition</h2>
    <h3 class="text-3xl md:text-4xl font-medium mb-8">Awards</h3>

    {/* Three.js Canvas Container */}
    <div id="threejs-container" class="relative mb-12 h-72 md:h-96 w-full rounded-2xl overflow-hidden bg-gradient-to-br from-[#0a0a0a] via-[#1a1a1a] to-[#0a0a0a] border border-[#ffffff08]">
      <canvas id="awards-canvas" class="w-full h-full"></canvas>
      
      {/* Text Overlay */}
      <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-10">
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-white opacity-90 text-center px-4">
          I AM HONORED TO WORK
        </h2>
        <h3 class="text-2xl md:text-4xl lg:text-5xl font-bold text-[var(--sec)] mt-2 text-center px-4">
          WITH SPECIAL PEOPLE
        </h3>
        <p class="text-sm md:text-base text-[var(--white-icon)] mt-4 text-center px-4">
          & I win awards sometimes
        </p>
      </div>
    </div>

    {/* Awards tags with hover effects */}
    <div class="awards flex flex-wrap gap-3 mb-8">
      {
        awards.slice(0, 5).map((award) => (
          <a
            href={`/awards/${award.id}`}
            class="tag trophy relative border border-[rgba(59,130,246,.5)] bg-[rgba(59,130,246,0.2)] text-white px-4 py-3 rounded-full font-semibold transition-all duration-250 ease-in-out backdrop-blur-sm hover:bg-[rgba(59,130,246,0.4)] hover:shadow-[0_0_16px_rgba(59,130,246,0.75)] hover:-translate-y-1"
          >
            {award.title}
            <span class="trophy-icon absolute -right-3 -top-4 w-9 h-9 opacity-0 translate-y-1.5 scale-90 transition-all duration-180 ease-in-out pointer-events-none drop-shadow-lg">
              <img src="/awards.webp" alt="Trophy" class="w-full h-full object-contain" />
            </span>
          </a>
        ))
      }
      <a
        href="https://www.instagram.com/p/DJzHz98PCEH/?img_index=1"
        target="_blank"
        rel="noopener noreferrer"
        class="tag trophy relative border border-[rgba(59,130,246,.5)] bg-[rgba(59,130,246,0.2)] text-white px-4 py-3 rounded-full font-semibold transition-all duration-250 ease-in-out backdrop-blur-sm hover:bg-[rgba(59,130,246,0.4)] hover:shadow-[0_0_16px_rgba(59,130,246,0.75)] hover:-translate-y-1"
      >
        & More
        <span class="trophy-icon absolute -right-3 -top-4 w-9 h-9 opacity-0 translate-y-1.5 scale-90 transition-all duration-180 ease-in-out pointer-events-none drop-shadow-lg">
          <img src="/awards.webp" alt="Trophy" class="w-full h-full object-contain" />
        </span>
      </a>
    </div>

    {/* View More Button */}
    <div class="flex justify-center">
      <button
        id="open-awards-panel"
        class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-[var(--sec)] to-blue-400 text-white font-medium hover:shadow-lg hover:shadow-[var(--sec)]/50 transition-all duration-300 hover:scale-105"
      >
        <span>View More</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
        </svg>
      </button>
    </div>
  </div>
</section>

{/* Slide-in Panel for All Awards */}
<div id="awards-panel" class="fixed top-0 right-0 w-full md:w-2/3 lg:w-1/2 h-full bg-[#111] border-l border-[#ffffff10] transform translate-x-full transition-transform duration-300 ease-in-out z-[102] overflow-y-auto">
  <div class="p-8">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-white">All Awards & Recognitions</h2>
      <button id="close-awards-panel" class="text-white hover:text-[var(--sec)] transition p-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="space-y-6">
      {
        awards.map((award) => (
          <a
            href={`/awards/${award.id}`}
            class="group block p-6 rounded-2xl bg-[#1a1a1a] border border-[#ffffff10] hover:border-[var(--sec)] transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <img
                  src={award.image}
                  alt={`${award.title} trophy`}
                  class="w-20 h-20 object-contain drop-shadow-lg"
                />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-white group-hover:text-[var(--sec)] transition">
                  {award.title}
                </h3>
                <p class="text-sm text-[var(--white-icon)] mt-1">{award.description}</p>
                <div class="flex items-center gap-4 mt-2 text-sm text-[var(--white-icon)]">
                  {award.issuer && <span>• {award.issuer}</span>}
                  {award.date && <span>• {award.date}</span>}
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--white-icon)] group-hover:text-[var(--sec)] transition group-hover:translate-x-1 flex-shrink-0">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

{/* Awards Overlay */}
<div id="awards-overlay" class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-[101]"></div>

<script is:inline>
  // Awards panel functionality
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-awards-panel");
    const closeBtn = document.getElementById("close-awards-panel");
    const panel = document.getElementById("awards-panel");
    const overlay = document.getElementById("awards-overlay");

    const openPanel = () => {
      panel.classList.remove("translate-x-full");
      overlay.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    };

    const closePanel = () => {
      panel.classList.add("translate-x-full");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    };

    if (openBtn) openBtn.addEventListener("click", openPanel);
    if (closeBtn) closeBtn.addEventListener("click", closePanel);
    if (overlay) overlay.addEventListener("click", closePanel);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePanel();
    });
  });
</script>

<script is:inline type="module">
  // Enhanced Three.js Animation with Statue
  import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";
  import { OrbitControls } from "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("threejs-container");
    const canvas = document.getElementById("awards-canvas");

    if (!container || !canvas) return;

    // Scene setup
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0a0a0a, 0.1);
    
    const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.set(0, 0.5, 3.5);
    
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x0a0a0a, 0);
    
    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
    scene.add(ambientLight);
    
    const directionalLight1 = new THREE.DirectionalLight(0x3b82f6, 1.5);
    directionalLight1.position.set(2, 3, 2);
    scene.add(directionalLight1);
    
    const directionalLight2 = new THREE.DirectionalLight(0x06b6d4, 0.8);
    directionalLight2.position.set(-2, 1, -1);
    scene.add(directionalLight2);
    
    const pointLight = new THREE.PointLight(0x8b5cf6, 1, 10);
    pointLight.position.set(0, 1, 2);
    scene.add(pointLight);

    // Create bust/head (statue)
    function createStatue() {
      const group = new THREE.Group();
      
      // Head
      const headGeometry = new THREE.SphereGeometry(0.5, 64, 64);
      
      // Modify vertices to create a more realistic head shape
      const positions = headGeometry.attributes.position;
      for (let i = 0; i < positions.count; i++) {
        const x = positions.getX(i);
        const y = positions.getY(i);
        const z = positions.getZ(i);
        
        // Stretch head vertically
        let newY = y * 1.2;
        
        // Add some character to the head
        if (y > 0) {
          newY += Math.sin(x * 2) * 0.05;
        }
        
        positions.setXYZ(i, x, newY, z * 1.1);
      }
      positions.needsUpdate = true;
      headGeometry.computeVertexNormals();
      
      const headMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        roughness: 0.3,
        metalness: 0.8,
      });
      
      const head = new THREE.Mesh(headGeometry, headMaterial);
      head.position.y = 0.2;
      group.add(head);
      
      // Neck
      const neckGeometry = new THREE.CylinderGeometry(0.15, 0.2, 0.3, 32);
      const neckMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        roughness: 0.3,
        metalness: 0.8,
      });
      const neck = new THREE.Mesh(neckGeometry, neckMaterial);
      neck.position.y = -0.3;
      group.add(neck);
      
      // Shoulders/Bust
      const bustGeometry = new THREE.SphereGeometry(0.7, 32, 16, 0, Math.PI * 2, 0, Math.PI / 2);
      const bustMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        roughness: 0.3,
        metalness: 0.8,
        side: THREE.DoubleSide
      });
      const bust = new THREE.Mesh(bustGeometry, bustMaterial);
      bust.position.y = -0.5;
      bust.scale.set(1, 0.7, 0.6);
      group.add(bust);
      
      // Nose
      const noseGeometry = new THREE.ConeGeometry(0.06, 0.2, 8);
      const noseMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a1a1a,
        roughness: 0.3,
        metalness: 0.8,
      });
      const nose = new THREE.Mesh(noseGeometry, noseMaterial);
      nose.position.set(0, 0.1, 0.45);
      nose.rotation.x = Math.PI / 2;
      group.add(nose);
      
      return group;
    }

    const statue = createStatue();
    scene.add(statue);

    // Create particles
    const particlesGeometry = new THREE.BufferGeometry();
    const particlesCount = 1000;
    const posArray = new Float32Array(particlesCount * 3);
    const colorArray = new Float32Array(particlesCount * 3);
    
    const colors = [
      new THREE.Color(0x3b82f6),
      new THREE.Color(0x06b6d4),
      new THREE.Color(0x8b5cf6),
      new THREE.Color(0xffffff)
    ];
    
    for (let i = 0; i < particlesCount * 3; i += 3) {
      const radius = Math.random() * 3 + 1;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.random() * Math.PI;
      
      posArray[i] = radius * Math.sin(phi) * Math.cos(theta);
      posArray[i + 1] = radius * Math.cos(phi) * 0.8;
      posArray[i + 2] = radius * Math.sin(phi) * Math.sin(theta);
      
      const color = colors[Math.floor(Math.random() * colors.length)];
      colorArray[i] = color.r;
      colorArray[i + 1] = color.g;
      colorArray[i + 2] = color.b;
    }
    
    particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
    particlesGeometry.setAttribute('color', new THREE.BufferAttribute(colorArray, 3));
    
    const particlesMaterial = new THREE.PointsMaterial({
      size: 0.025,
      vertexColors: true,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending
    });
    
    const particles = new THREE.Points(particlesGeometry, particlesMaterial);
    scene.add(particles);

    // Controls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;

    // Mouse movement
    let mouseX = 0;
    let mouseY = 0;
    
    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      mouseY = -((e.clientY - rect.top) / rect.height - 0.5) * 2;
    });

    const clock = new THREE.Clock();
    
    const animate = () => {
      const elapsedTime = clock.getElapsedTime();
      
      // Animate particles
      particles.rotation.y = elapsedTime * 0.1;
      particles.rotation.x = elapsedTime * 0.05;
      
      // Animate statue
      statue.rotation.y = Math.sin(elapsedTime * 0.3) * 0.15 + mouseX * 0.1;
      statue.rotation.x = Math.sin(elapsedTime * 0.2) * 0.05 + mouseY * 0.05;
      
      // Breathe effect
      const breatheScale = 1 + Math.sin(elapsedTime * 1.5) * 0.02;
      statue.scale.set(breatheScale, breatheScale, breatheScale);
      
      // Animate lights
      pointLight.position.x = Math.sin(elapsedTime * 0.8) * 1.5;
      pointLight.position.z = Math.cos(elapsedTime * 0.8) * 1.5;
      pointLight.intensity = 0.8 + Math.sin(elapsedTime * 2) * 0.3;
      
      controls.update();
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    };
    
    animate();
    
    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  });
</script>

<style>
  .tag:hover .trophy-icon,
  .tag:focus-visible .trophy-icon,
  .tag:active .trophy-icon {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (max-width: 768px) {
    .tag {
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
    }
  }
</style>
