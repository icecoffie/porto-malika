---
import { awards } from "../data/awards";
---

<section id="awards" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Recognition</h2>
    <h3 class="text-3xl md:text-4xl font-medium mb-8">Awards</h3>

    {/* Awards tags with hover effects */}
    <div class="awards flex flex-wrap gap-3 mb-8">
      {
        awards.slice(0, 7).map((award) => (
          <a
            href={`/awards/${award.id}`}
            class="tag trophy relative border border-[rgba(59,130,246,.5)] bg-[rgba(59,130,246,0.2)] text-white px-4 py-3 rounded-full font-semibold transition-all duration-250 ease-in-out backdrop-blur-sm hover:bg-[rgba(59,130,246,0.4)] hover:shadow-[0_0_16px_rgba(59,130,246,0.75)] hover:-translate-y-1"
          >
            {award.title}
            <span class="trophy-icon absolute -right-3 -top-4 w-9 h-9 opacity-0 translate-y-1.5 scale-90 transition-all duration-180 ease-in-out pointer-events-none drop-shadow-lg">
              <img src="/awards.webp" alt="Trophy" class="w-full h-full object-contain" />
            </span>
          </a>
        ))
      }
    </div>

    {/* View More Button */}
    <div class="flex justify-center">
      <button
        id="open-awards-panel"
        class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-[var(--sec)] to-blue-400 text-white font-medium hover:shadow-lg hover:shadow-[var(--sec)]/50 transition-all duration-300 hover:scale-105"
      >
        <span>View More</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
        </svg>
      </button>
    </div>
  </div>
</section>

{/* Slide-in Panel for All Awards */}
<div id="awards-panel" class="fixed top-0 right-0 w-full md:w-2/3 lg:w-1/2 h-full bg-[#111] border-l border-[#ffffff10] transform translate-x-full transition-transform duration-300 ease-in-out z-[102] overflow-y-auto">
  <div class="p-8">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-white">All Awards & Recognitions</h2>
      <button id="close-awards-panel" class="text-white hover:text-[var(--sec)] transition p-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="space-y-6">
      {
        awards.map((award) => (
          <a
            href={`/awards/${award.id}`}
            class="group block p-6 rounded-2xl bg-[#1a1a1a] border border-[#ffffff10] hover:border-[var(--sec)] transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <img
                  src={award.image}
                  alt={`${award.title} trophy`}
                  class="w-20 h-20 object-contain drop-shadow-lg"
                />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-white group-hover:text-[var(--sec)] transition">
                  {award.title}
                </h3>
                <p class="text-sm text-[var(--white-icon)] mt-1">{award.description}</p>
                <div class="flex items-center gap-4 mt-2 text-sm text-[var(--white-icon)]">
                  {award.issuer && <span>• {award.issuer}</span>}
                  {award.date && <span>• {award.date}</span>}
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--white-icon)] group-hover:text-[var(--sec)] transition group-hover:translate-x-1 flex-shrink-0">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

{/* Awards Overlay */}
<div id="awards-overlay" class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-[101]"></div>

<script is:inline>
  // Awards panel functionality
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-awards-panel");
    const closeBtn = document.getElementById("close-awards-panel");
    const panel = document.getElementById("awards-panel");
    const overlay = document.getElementById("awards-overlay");

    const openPanel = () => {
      panel.classList.remove("translate-x-full");
      overlay.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    };

    const closePanel = () => {
      panel.classList.add("translate-x-full");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    };

    if (openBtn) openBtn.addEventListener("click", openPanel);
    if (closeBtn) closeBtn.addEventListener("click", closePanel);
    if (overlay) overlay.addEventListener("click", closePanel);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePanel();
    });
  });
</script>

<style>
  .tag:hover .trophy-icon,
  .tag:focus-visible .trophy-icon,
  .tag:active .trophy-icon {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (max-width: 768px) {
    .tag {
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
    }
  }
</style>
