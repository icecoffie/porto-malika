---
import LineSidebar from "../React/LineSidebar.tsx";
import { papers } from "../data/papers";
---

<section id="papers" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Research & Publications</h2>
    <h3 class="text-3xl md:text-4xl font-medium mb-8">Academic Papers</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 lg:gap-8">
      {/* LineSidebar */}
      <div class="papers-sidebar-wrapper rounded-2xl overflow-hidden border border-[#ffffff10] bg-gradient-to-b from-[#1a1a1a] to-[#0a0a0a] col-span-1">
        <LineSidebar
          client:load
          items={papers.map(p => ({
            label: p.title,
            href: p.link
          }))}
          accentColor="var(--sec)"
          textColor="rgba(255, 255, 255, 0.6)"
          markerColor="rgba(255, 255, 255, 0.2)"
          showIndex={true}
          showMarker={true}
          proximityRadius={120}
          maxShift={25}
          falloff="smooth"
          markerLength={50}
          markerGap={15}
          tickScale={0.6}
          scaleTick={true}
          itemGap={24}
          fontSize={0.95}
          smoothing={120}
          defaultActive={0}
          onItemClick={(index: number) => {
            if (typeof window !== 'undefined') {
              const cards = document.querySelectorAll('.paper-card');
              cards.forEach((card, idx) => {
                if (idx === index) {
                  card.classList.add('active');
                } else {
                  card.classList.remove('active');
                }
              });
            }
          }}
        />
      </div>

      {/* Papers Info */}
      <div class="md:col-span-1 lg:col-span-2 space-y-3 md:space-y-4">
        {papers.map((paper, index) => (
          <div 
            class={`paper-card p-4 md:p-5 rounded-lg md:rounded-2xl transition-all duration-300 ${
              index === 0 
                ? 'active bg-[#1a1a1a]/60 border border-[var(--sec)]/50' 
                : 'bg-[#1a1a1a]/30 border border-transparent hover:border-[#ffffff10]'
            }`}
            id={`paper-${index}`}
          >
            <div class="space-y-2">
              <div>
                <h4 class="text-sm md:text-base lg:text-lg font-bold text-white leading-tight pr-1">
                  {paper.title}
                </h4>
                <p class="text-xs text-[var(--white-icon)]/60 mt-1">
                  {paper.journal} • {paper.year}
                </p>
              </div>

              <p class="text-xs md:text-sm text-[var(--white-icon)] leading-relaxed line-clamp-2 md:line-clamp-3">
                {paper.description}
              </p>

              <div class="flex flex-wrap items-center gap-2 pt-2">
                <span class="px-2 py-0.5 rounded text-xs font-semibold bg-[var(--sec)]/20 text-[var(--sec)] border border-[var(--sec)]/50 whitespace-nowrap">
                  {paper.type}
                </span>
                <a
                  href={paper.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[var(--sec)] hover:text-[var(--sec)]/80 transition font-medium text-xs"
                >
                  Read
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .papers-sidebar-wrapper {
    min-height: 280px;
    display: flex;
    align-items: center;
    padding: 1rem;
  }

  .paper-card {
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .paper-card.active {
    background-color: rgba(26, 26, 26, 0.6);
    border-color: var(--sec);
    box-shadow: 0 0 20px rgba(99, 179, 237, 0.1);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Mobile first */
  @media (max-width: 767px) {
    .papers-sidebar-wrapper {
      min-height: 260px;
      padding: 1rem;
      margin-bottom: 0.5rem;
    }
  }

  /* Tablet */
  @media (min-width: 768px) {
    .papers-sidebar-wrapper {
      min-height: 320px;
      padding: 1.25rem;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .papers-sidebar-wrapper {
      min-height: 380px;
      padding: 1.5rem;
    }
  }
</style>
