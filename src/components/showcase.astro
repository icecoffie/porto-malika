---
import FlowingMenu from "../React/FlowingMenu.tsx";
import { showcaseItems } from "../data/showcase";
---

<section id="showcase" class="py-8 md:py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="w-full max-w-7xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Moments</h2>
    <h3 class="text-3xl md:text-4xl font-medium mb-6 md:mb-8">Showcase</h3>

    {/* Flowing Menu Container */}
    <div class="showcase-container rounded-2xl overflow-hidden border border-[#ffffff10]">
      <FlowingMenu
        client:idle
        items={showcaseItems}
        speed={15}
        textColor="var(--white)"
        bgColor="var(--background)"
        marqueeBgColor="var(--sec)"
        marqueeTextColor="var(--background)"
        borderColor="rgba(255,255,255,0.1)"
      />
    </div>
  </div>
</section>

<style>
  .showcase-container {
    height: 280px;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
  }

  @media (min-width: 640px) {
    .showcase-container {
      height: 320px;
    }
  }

  @media (min-width: 768px) {
    .showcase-container {
      height: 360px;
    }
  }

  @media (min-width: 1024px) {
    .showcase-container {
      height: 400px;
    }
  }
</style>
