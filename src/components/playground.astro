---
import TechPlayground from "./TechPlayground.tsx";
---

<section
  id="playground"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-6xl mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-8">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Interactive Demo</h2>
      <h3 class="text-4xl md:text-5xl font-medium mb-4">Tech Memory Game</h3>
      <p class="text-lg text-[var(--white-icon)] max-w-3xl">
        Test your memory with this tech themed matching game. Match all the icons to win!
      </p>
    </div>

    <!-- Playground -->
    <TechPlayground client:load />
