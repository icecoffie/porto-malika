---
import { projects } from "../data/projects";
import { highlightProjects } from "../data/featured";

// Define specific projects to show in detail
const detailedProjectIds = [
  "matrix-sync-tech",
  "skale-orbit",
  "worcket",
  "orbit-awards",
  "freedoom",
  "skale-academy"
];

// Get detailed projects
const detailedProjects = [
  ...highlightProjects.filter(p => detailedProjectIds.includes(p.id)),
  ...projects.filter(p => detailedProjectIds.includes(p.id))
].filter((v, i, a) => a.findIndex(t => t.id === v.id) === i); // Remove duplicates

// Get all other projects for the list
const otherProjects = [
  ...highlightProjects.filter(p => !detailedProjectIds.includes(p.id)),
  ...projects.filter(p => !detailedProjectIds.includes(p.id))
].filter((v, i, a) => a.findIndex(t => t.id === v.id) === i);
---

<section id="projects" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My Work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-12">Projects</h3>

    {/* Detailed Projects Grid */}
    <div class="space-y-12 mb-16">
      {
        detailedProjects.map((project) => (
          <article class="group relative rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 bg-gradient-to-br from-[#111] to-[#0a0a0a] border border-[#ffffff08] hover:border-[var(--sec)]/50">
            <a href={`/projects/${project.id}`} class="block">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                {/* Image Side */}
                <div class="relative overflow-hidden">
                  <img
                    src={project.image}
                    alt={`${project.title} screenshot`}
                    class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                  {project.status && (
                    <div class="absolute top-4 left-4 bg-[var(--sec)]/90 text-white px-3 py-1 rounded-full text-sm font-medium">
                      {project.status}
                    </div>
                  )}
                </div>
                
                {/* Content Side */}
                <div class="p-6 lg:p-8 flex flex-col justify-center">
                  <h4 class="text-2xl md:text-3xl font-bold text-white mb-3">
                    {project.title}
                  </h4>
                  {((project as any).tagline || project.description) && (
                    <p class="text-[var(--sec)] text-lg mb-4">
                      {(project as any).tagline || project.description}
                    </p>
                  )}
                  
                  {/* Why/How/What Preview */}
                  <div class="space-y-3 mb-6">
                    {project.why && (
                      <div class="flex items-start gap-2">
                        <span class="text-[var(--sec)] font-bold">Why:</span>
                        <p class="text-[var(--white-icon)] text-sm line-clamp-2">{project.why}</p>
                      </div>
                    )}
                    {project.how && (
                      <div class="flex items-start gap-2">
                        <span class="text-[var(--sec)] font-bold">How:</span>
                        <p class="text-[var(--white-icon)] text-sm line-clamp-2">{project.how}</p>
                      </div>
                    )}
                    {project.what && (
                      <div class="flex items-start gap-2">
                        <span class="text-[var(--sec)] font-bold">What:</span>
                        <p class="text-[var(--white-icon)] text-sm line-clamp-2">{project.what}</p>
                      </div>
                    )}
                  </div>
                  
                  {/* Tech Stack */}
                  {project.techStack && (
                    <div class="flex flex-wrap gap-2 mb-6">
                      {project.techStack.slice(0, 5).map((tech) => (
                        <span class="px-3 py-1 bg-[#ffffff08] border border-[#ffffff10] rounded-full text-sm text-[var(--white-icon)]">
                          {tech}
                        </span>
                      ))}
                      {project.techStack.length > 5 && (
                        <span class="px-3 py-1 bg-[#ffffff08] border border-[#ffffff10] rounded-full text-sm text-[var(--white-icon)]">
                          +{project.techStack.length - 5}
                        </span>
                      )}
                    </div>
                  )}
                  
                  {/* CTA */}
                  <span class="inline-flex items-center gap-2 text-[var(--sec)] font-medium group-hover:gap-3 transition-all">
                    View Full Details
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    {/* Another Projects Button */}
    <button
      id="open-projects-panel"
      class="w-full flex items-center justify-center gap-2 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">Another Projects →</span>
    </button>
  </div>
</section>

{/* Slide-in Panel for All Projects */}
<div id="projects-panel" class="fixed top-0 right-0 w-full md:w-2/3 lg:w-1/2 h-full bg-[#111] border-l border-[#ffffff10] transform translate-x-full transition-transform duration-300 ease-in-out z-50 overflow-y-auto">
  <div class="p-8">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-white">Selected Projects List (2024-2020)</h2>
      <button id="close-projects-panel" class="text-white hover:text-[var(--sec)] transition p-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="space-y-4">
      {
        otherProjects.map((project, index) => (
          <a
            href={`/projects/${project.id}`}
            class="flex items-center gap-4 py-4 px-3 rounded-xl border border-[#ffffff10] hover:border-[var(--sec)] hover:bg-[#ffffff05] transition group"
          >
            <img
              src={project.image}
              alt={`${project.title} preview`}
              class="w-20 h-20 object-cover rounded-lg flex-shrink-0"
              loading="lazy"
            />
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-white group-hover:text-[var(--sec)] transition">
                {project.title}
              </h3>
              <p class="text-sm text-[var(--white-icon)] mt-1">{project.status}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-[var(--white-icon)]">{(new Date().getFullYear() - (index % 5)).toString()}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--white-icon)] group-hover:text-[var(--sec)] transition group-hover:translate-x-1">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

{/* Overlay */}
<div id="projects-overlay" class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-40"></div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-projects-panel");
    const closeBtn = document.getElementById("close-projects-panel");
    const panel = document.getElementById("projects-panel");
    const overlay = document.getElementById("projects-overlay");

    const openPanel = () => {
      panel.classList.remove("translate-x-full");
      overlay.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    };

    const closePanel = () => {
      panel.classList.add("translate-x-full");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    };

    if (openBtn) openBtn.addEventListener("click", openPanel);
    if (closeBtn) closeBtn.addEventListener("click", closePanel);
    if (overlay) overlay.addEventListener("click", closePanel);

    // Close with Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePanel();
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
