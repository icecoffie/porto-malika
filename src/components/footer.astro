---
import LikeButton from "../React/LikeButton.tsx";
import WavesShader from "../React/WavesShader.tsx";
---

<style>
  .footer {
    position: relative;
    min-height: 40vh; 
    padding: 78px 0 50px;
    background: transparent;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 150px;
    background: linear-gradient(to bottom, var(--background) 0%, rgba(16, 16, 16, .72) 38%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }
  .footer-shader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: .82;
    pointer-events: none;
  }
</style>

<footer class="footer w-full">
  <WavesShader client:load className="footer-shader" />
  <div class="relative z-10 w-full px-6 md:px-10 lg:px-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Like -->
      <div class="flex flex-col items-center md:items-start justify-center space-y-10">
        <LikeButton client:load />
      </div>

      <!-- Spotify -->
      <div class="flex flex-col items-center space-y-6">
        <div class="w-full max-w-xs">
          <iframe
            style="border-radius:12px; border:0;"
            src="https://open.spotify.com/embed/playlist/6EuOoViwmR29qjsxexYbhq?utm_source=generator"
            class="w-full h-40"
            allowfullscreen=""
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Enjoy The Playlist"></iframe>
        </div>
      </div>

      <!-- WhatsApp CTA -->
      <div class="flex flex-col items-center md:items-end justify-center space-y-4">
        <p class="text-sm text-[var(--white-icon)] text-center md:text-right">
          Ready to dive in? <a href="https://wa.me/6285187732004" target="_blank" class="text-[var(--accent)] underline">Let's go deeper.</a>
        </p>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-[#ffffff10] relative z-10">
      <p class="text-center text-sm text-[var(--white-icon)]">
        © 2026 🐧🧊 <a href="https://github.com/icecoffie">Malika Shakila</a>. All rights reserved.
      </p>
    </div>
  </div>
</footer>
