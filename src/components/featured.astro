---
import { highlightProjects } from "../data/featured";
---

<section
  id="featured"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)] overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-12 text-center">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Highlight Projects</h2>
      <h3 class="text-3xl md:text-4xl font-medium mb-4">Original Products</h3>
      <p class="text-base text-[var(--white-icon)] max-w-2xl mx-auto">
        Original products I built from scratch to solve real problems I experienced.
      </p>
    </div>

    <!-- Carousel Container -->
    <div class="relative">
      <!-- Carousel Wrapper -->
      <div id="carousel-track" class="flex gap-6 transition-transform duration-500 ease-out">
        {
          highlightProjects.map((project, index) => (
            <article 
              class="carousel-item flex-shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] group"
              data-index={index}
            >
              <a href={`/projects/${project.id}`} class="block h-full">
                <div class="relative h-full rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 bg-gradient-to-br from-[#111] to-[#0a0a0a] border border-[#ffffff08] hover:border-[var(--sec)]/50 hover:-translate-y-2">
                  
                  {/* Image */}
                  <div class="relative overflow-hidden h-48">
                    <img
                      src={project.image}
                      alt={`${project.title} screenshot`}
                      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                      loading="lazy"
                    />
                    
                    {/* Overlay Gradient */}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                    
                    {/* Status Badge */}
                    <div class="absolute top-3 right-3 bg-black/70 backdrop-blur-sm text-white px-2 py-1 rounded-full text-xs border border-[var(--sec)]">
                      {project.status}
                    </div>
                    
                    {/* Title Overlay */}
                    <div class="absolute bottom-0 left-0 right-0 p-4">
                      <h4 class="text-xl font-bold text-white mb-1">
                        {project.title}
                      </h4>
                      <p class="text-xs text-[var(--sec)] font-medium line-clamp-1">
                        {project.tagline}
                      </p>
                    </div>
                  </div>

                  {/* Content */}
                  <div class="p-4 space-y-3">
                    {/* Description */}
                    <p class="text-sm text-[var(--white-icon)] leading-relaxed line-clamp-2">
                      {project.description}
                    </p>

                    {/* Impact */}
                    <div class="flex items-start gap-2 p-2 rounded-lg bg-[#ffffff05]">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[var(--sec)] flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M13 10H18L12 23V14H7L13 1V10Z"/>
                      </svg>
                      <p class="text-xs text-white font-medium line-clamp-2">
                        {project.impact}
                      </p>
                    </div>

                    {/* Tech Stack */}
                    <div class="flex flex-wrap gap-1.5">
                      {project.techStack.slice(0, 3).map((tech) => (
                        <span class="px-2 py-0.5 bg-[#ffffff08] border border-[#ffffff10] rounded-full text-xs text-[var(--white-icon)]">
                          {tech}
                        </span>
                      ))}
                      {project.techStack.length > 3 && (
                        <span class="px-2 py-0.5 bg-[#ffffff08] border border-[#ffffff10] rounded-full text-xs text-[var(--white-icon)]">
                          +{project.techStack.length - 3}
                        </span>
                      )}
                    </div>

                    {/* CTA */}
                    <div class="pt-2">
                      <span class="inline-flex items-center gap-1 text-[var(--sec)] text-sm font-medium group-hover:gap-2 transition-all">
                        View Case Study
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <!-- Navigation Arrows -->
      <button
        id="prev-btn"
        class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 items-center justify-center rounded-full bg-black/80 backdrop-blur-sm border border-[var(--sec)] text-white hover:bg-[var(--sec)] transition-all duration-300 z-10"
        aria-label="Previous"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10.8284 12.0007L15.7782 16.9504L14.364 18.3646L8 12.0007L14.364 5.63672L15.7782 7.05093L10.8284 12.0007Z"/>
        </svg>
      </button>

      <button
        id="next-btn"
        class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 items-center justify-center rounded-full bg-black/80 backdrop-blur-sm border border-[var(--sec)] text-white hover:bg-[var(--sec)] transition-all duration-300 z-10"
        aria-label="Next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13.1717 12.0007L8.22192 7.05093L9.63614 5.63672L16.0001 12.0007L9.63614 18.3646L8.22192 16.9504L13.1717 12.0007Z"/>
        </svg>
      </button>
    </div>

    <!-- Dots Indicator -->
    <div id="dots-container" class="flex justify-center gap-2 mt-8">
      {highlightProjects.map((_, index) => (
        <button
          class="dot w-2 h-2 rounded-full bg-[var(--white-icon)] transition-all duration-300 hover:bg-[var(--sec)]"
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>

    <!-- Divider -->
    <div class="mt-12 pt-8 border-t border-[#ffffff10]">
      <p class="text-center text-[var(--white-icon)] text-sm">
        Below are client projects and collaborations. 
        <span class="text-[var(--sec)] font-medium">The ones above are built from the heart.</span>
      </p>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const dots = document.querySelectorAll('.dot');
  const items = document.querySelectorAll('.carousel-item');
  
  let currentIndex = 0;
  let itemsPerView = 1;

  function updateItemsPerView() {
    if (window.innerWidth >= 1024) {
      itemsPerView = 3;
    } else if (window.innerWidth >= 768) {
      itemsPerView = 2;
    } else {
      itemsPerView = 1;
    }
  }

  function updateCarousel() {
    if (!track) return;
    
    const firstItem = items[0] as HTMLElement;
    const itemWidth = firstItem?.offsetWidth || 0;
    const gap = 24; // 6 * 4px (gap-6)
    const offset = -(currentIndex * (itemWidth + gap));
    
    track.style.transform = `translateX(${offset}px)`;
    
    // Update dots
    dots.forEach((dot, index) => {
      if (index === currentIndex) {
        dot.classList.add('bg-[var(--sec)]', 'w-8');
        dot.classList.remove('bg-[var(--white-icon)]', 'w-2');
      } else {
        dot.classList.remove('bg-[var(--sec)]', 'w-8');
        dot.classList.add('bg-[var(--white-icon)]', 'w-2');
      }
    });
  }

  function goToSlide(index: number) {
    const maxIndex = Math.max(0, items.length - itemsPerView);
    currentIndex = Math.max(0, Math.min(index, maxIndex));
    updateCarousel();
  }

  prevBtn?.addEventListener('click', () => {
    goToSlide(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    goToSlide(currentIndex + 1);
  });

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      goToSlide(index);
    });
  });

  // Auto-play
  let autoplayInterval = setInterval(() => {
    const maxIndex = Math.max(0, items.length - itemsPerView);
    if (currentIndex >= maxIndex) {
      goToSlide(0);
    } else {
      goToSlide(currentIndex + 1);
    }
  }, 5000);

  // Pause on hover
  track?.addEventListener('mouseenter', () => {
    clearInterval(autoplayInterval);
  });

  track?.addEventListener('mouseleave', () => {
    autoplayInterval = setInterval(() => {
      const maxIndex = Math.max(0, items.length - itemsPerView);
      if (currentIndex >= maxIndex) {
        goToSlide(0);
      } else {
        goToSlide(currentIndex + 1);
      }
    }, 5000);
  });

  // Handle resize
  window.addEventListener('resize', () => {
    updateItemsPerView();
    goToSlide(currentIndex);
  });

  // Initialize
  updateItemsPerView();
  updateCarousel();
</script>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dot.bg-\[var\(--sec\)\] {
    background-color: var(--sec);
  }
</style>
